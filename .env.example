PORT=3000
PUBLIC_BASE_URL=https://sub.example.com

# First URL segment of the public subscription page and links.
# Allowed: letters, digits, `_`, `-`, 1-32 chars. Reserved: api, assets, health.
# Example: SUB_PATH=cars serves https://sub.example.com/cars/<token>
# An invalid value falls back to `sub` and logs an error at startup.
SUB_PATH=sub

# How many proxy hops in front of the portal are trusted for the client IP.
# `1` (default) is correct for a single reverse proxy / Docker gateway (npmplus).
# Use `loopback, linklocal, uniquelocal` or `true` behind a trusted CDN.
TRUST_PROXY=1

# Rate-limit thresholds for public subscription routes (token lookups).
# `RATE_LIMIT_MAX_REQUESTS` per `RATE_LIMIT_WINDOW_MS` milliseconds.
# `RATE_LIMIT_FAILURE_THRESHOLD` consecutive 404/4xx -> `RATE_LIMIT_BLOCK_MS` block.
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=12
# RATE_LIMIT_FAILURE_THRESHOLD=5
# RATE_LIMIT_BLOCK_MS=900000

PANEL_URL=https://panel.example.com:2053/secretpath
PANEL_USERNAME=admin
PANEL_PASSWORD=password
CACHE_TTL_SECONDS=15

# Base URL of the panel's own Subscription service (3x-ui "Subscription" port).
# When set, /sub links are taken verbatim from the panel instead of being built
# from the inbound list. Leave empty to keep the local builder.
# Inside Docker, use host.docker.internal to reach a service on the host.
XUI_SUB_URL=http://host.docker.internal:2096/sub

# ---------------------------------------------------------------------------
# Portal appearance and behaviour (exposed through GET /api/public-config).
# These values are public by design - never put panel data here.
# ---------------------------------------------------------------------------

# Page title, used in the browser tab and the header.
APP_TITLE=پنل اشتراک

# Announcement card on the subscription page.
ANNOUNCEMENT_ENABLED=true
ANNOUNCEMENT_TITLE=اطلاعیه مهم
ANNOUNCEMENT_TEXT=این یک متن اطلاعیه تستی است. برای دریافت آخرین وضعیت سرورها و راهنمای اتصال این بخش را بررسی کنید.

# Footer credit: rendered as "ساخته شده با ❤️ توسط <name>" linking to <url>.
FOOTER_AUTHOR_NAME=VPNacho
FOOTER_AUTHOR_URL=https://github.com/VPNacho

# Show the "look up a subscription" form on the site root.
ENABLE_HOME_LOOKUP=true

# `Profile-Update-Interval` header, in hours (1-720).
PROFILE_UPDATE_INTERVAL=12
