PORT=3000
PUBLIC_BASE_URL=https://sub.example.com
PANEL_URL=https://panel.example.com:2053/secretpath
PANEL_USERNAME=admin
PANEL_PASSWORD=password
CACHE_TTL_SECONDS=15

# Public host/IP written into generated vless:// links.
# Leave empty to inherit the panel host, but set it whenever the panel listens
# on 0.0.0.0 or sits behind a CDN / reverse proxy - otherwise clients receive
# an address they cannot reach.
VLESS_HOST=sub.example.com
