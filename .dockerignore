# Dependencies (reinstalled inside the image from lockfiles)
node_modules
**/node_modules

# Version control and local tooling state
.git
.gitignore
.agents
.codex

# Secrets / environment
.env
server/.env
client/.env
**/.env.local

# Build artifacts (frontend is built inside the image)
client/dist
dist
.npm-cache
**/.npm-cache

# Logs
*.log
**/*.log
npm-debug.log*
yarn-error.log*

# Temp / scratch files
.tmp-*
tmp/
temp/
*.tmp
*.swp
*.bak

# Editor / OS noise
.vscode
.idea
.DS_Store
Thumbs.db

# Docs and compose files are not needed to build the image
README.md
docker-compose.yml
